[Unit]
Description=Discord Admin Bot for Squad server administration
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discord
Group=discord

# Join the `squad` group as a supplementary group so the bot can read + write the Squad
# config files that live under the squad user's tree. The target directories must have the
# SGID bit set so newly created files (tmp files, *.bak.*) inherit group=squad.
SupplementaryGroups=squad

# 0027 = owner rwx, group rx, other none. Keeps accidental writes from leaking to 'other'.
UMask=0027

WorkingDirectory=/opt/bots/discord-admin-bot-squad
EnvironmentFile=/opt/bots/discord-admin-bot-squad/.env
# Re-register slash commands on each start so changes to SQUAD_SERVICES (which
# becomes the `instance` choice list) are pushed to Discord without a manual step.
ExecStartPre=/usr/bin/node /opt/bots/discord-admin-bot-squad/src/deploy-commands.js
ExecStart=/usr/bin/node /opt/bots/discord-admin-bot-squad/src/index.js
Restart=on-failure
RestartSec=5s

# Hardening. Tighten further if it breaks nothing in your environment.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

# MemoryDenyWriteExecute is intentionally NOT set. Node.js's V8 JIT / Baseline compiler
# needs to allocate RW memory and flip it to RX at runtime; this flag aborts that
# transition with a V8 fatal ("Check failed: 12 == errno" in SetPermissions). If you ever
# switch the bot to `node --jitless`, you can re-enable MemoryDenyWriteExecute=true.

# NoNewPrivileges must stay false (or be overridden) because the bot shells out to `sudo`.
# If you decide to drop the sudo approach, set NoNewPrivileges=true and remove the sudo allowance.

# ReadWritePaths must include the directories the bot legitimately writes to.
# Populate these in a drop-in override (systemctl edit discord-admin-bot-squad) with the real paths, e.g.:
#   [Service]
#   ReadWritePaths=/opt/squad/Configs/supporter-train

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
