# /etc/sudoers.d/discord-admin-bot-squad
# Install with: install -m 0440 -o root -g root sudoers.d-discord-admin-bot-squad /etc/sudoers.d/discord-admin-bot-squad
# Validate with: visudo -c
#
# Allows the `discord` user to run ONLY the listed systemctl actions on the listed Squad
# instances, without a password. The bot invokes:
#   execFile('/usr/bin/sudo', ['-n', '/bin/systemctl', ACTION, SERVICE])
# No wildcards, no shell metacharacters: every exact argv combination is explicitly whitelisted.
#
# /update command pattern — each instance update is a separate oneshot service:
#   execFile('/usr/bin/sudo', ['-n', '/bin/systemctl', 'start', '--wait', 'squad-gameupdate@<n>.service'])
#   execFile('/usr/bin/sudo', ['-n', '/bin/journalctl', '-u', 'squad-gameupdate@<n>.service', '-f', '-n', '0', '-o', 'cat'])
#
# Adding a new instance is a THREE-PLACE edit BY DESIGN:
#   1. Add its /server lines below (5 lines).
#   2. Add its /update lines below (2 lines).
#   3. Append both the service name to SQUAD_SERVICES and the instance name to SQUAD_INSTANCES in .env.

Defaults:discord !requiretty

# =============================================================================
# /server command — systemctl start/stop/restart/status/is-active
# =============================================================================

# --- squad-public.service ---
discord ALL=(root) NOPASSWD: /bin/systemctl start squad-public.service, \
                             /bin/systemctl stop squad-public.service, \
                             /bin/systemctl restart squad-public.service, \
                             /bin/systemctl status squad-public.service, \
                             /bin/systemctl is-active squad-public.service

# --- squad-train.service ---
discord ALL=(root) NOPASSWD: /bin/systemctl start squad-train.service, \
                             /bin/systemctl stop squad-train.service, \
                             /bin/systemctl restart squad-train.service, \
                             /bin/systemctl status squad-train.service, \
                             /bin/systemctl is-active squad-train.service

# --- squad-supporter-train.service ---
discord ALL=(root) NOPASSWD: /bin/systemctl start squad-supporter-train.service, \
                             /bin/systemctl stop squad-supporter-train.service, \
                             /bin/systemctl restart squad-supporter-train.service, \
                             /bin/systemctl status squad-supporter-train.service, \
                             /bin/systemctl is-active squad-supporter-train.service

# =============================================================================
# /update command — oneshot rebuild services (no stop/start of game servers)
#
# squad-gameupdate@<instance>.service  →  /update instance
# squad-gameupdate-master.service      →  /update master
#
# Each pair: (1) start --wait blocks until the oneshot exits
#            (2) journalctl -f streams live output to Discord
# =============================================================================

# --- /update master (SteamCMD) ---
discord ALL=(root) NOPASSWD: /bin/systemctl start --wait squad-gameupdate-master.service
discord ALL=(root) NOPASSWD: /bin/journalctl -u squad-gameupdate-master.service -f -n 0 -o cat

# --- /update instance public ---
discord ALL=(root) NOPASSWD: /bin/systemctl start --wait squad-gameupdate@public.service
discord ALL=(root) NOPASSWD: /bin/journalctl -u squad-gameupdate@public.service -f -n 0 -o cat

# --- /update instance train ---
discord ALL=(root) NOPASSWD: /bin/systemctl start --wait squad-gameupdate@train.service
discord ALL=(root) NOPASSWD: /bin/journalctl -u squad-gameupdate@train.service -f -n 0 -o cat

# --- /update instance supporter-train ---
discord ALL=(root) NOPASSWD: /bin/systemctl start --wait squad-gameupdate@supporter-train.service
discord ALL=(root) NOPASSWD: /bin/journalctl -u squad-gameupdate@supporter-train.service -f -n 0 -o cat
