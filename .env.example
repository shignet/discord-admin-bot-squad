# Discord application credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Role IDs (Discord snowflakes) used for permission gating
# Senior admins: full control (server start/stop/restart/status, mod add/remove, patreonadmin add/remove)
# Admins: limited (server status, patreonadmin add/remove)
SENIOR_ADMIN_ROLE_ID=
ADMIN_ROLE_ID=

# Channel where the bot posts an audit message for every executed command
AUDIT_CHANNEL_ID=

# Comma-separated list of Squad systemd service names the bot may control via /server.
# Every entry listed here MUST also have an allow line in /etc/sudoers.d/discord-admin-bot-squad.
SQUAD_SERVICES=squad-public.service,squad-train.service,squad-supporter-train.service

# [NEW] Comma-separated list of Squad instance names the bot may rebuild via /update.
# Each name must match a directory under /opt/squad/Configs/<name>/
# and must also have a squad-gameupdate@<name>.service entry in sudoers.
# Typically the short name without the "squad-" prefix and ".service" suffix.
SQUAD_INSTANCES=public,train,supporter-train


# Comma-separated list of auxiliary systemd service names the bot may control via /service.
# Used for non-game daemons (SquadJS, whitelister, etc.). Every entry listed here MUST also
# have an allow line in /etc/sudoers.d/discord-admin-bot-squad. Leave unset to disable /service.
AUX_SERVICES=squadjs-public.service,whitelister.service


# Absolute path to the supporter-train Admins.cfg file
ADMINS_CFG_PATH=/absolute/path/to/supporter-train/Admins.cfg

# Absolute path to the supporter-train config.sh file
CONFIG_SH_PATH=/absolute/path/to/Configs/supporter-train/config.sh

# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
